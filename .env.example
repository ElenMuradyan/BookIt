# Web (Next.js) API & Mode Configuration
# Leave NEXT_PUBLIC_BOOKIT_API_URL empty to route browser calls through Next.js same-origin /api/v1/* proxy (preserves HttpOnly + CSRF cookies)
NEXT_PUBLIC_BOOKIT_API_URL=
BOOKIT_INTERNAL_API_URL=http://127.0.0.1:8000
# Set NEXT_PUBLIC_BOOKIT_USE_MOCKS=true to switch Web to offline frontend-only mock mode
NEXT_PUBLIC_BOOKIT_USE_MOCKS=false
# Optional: offline frontend-only demo preview unlock password (backend uses Argon2id database seeds)
NEXT_PUBLIC_BOOKIT_DEMO_SECRET=

# Mobile (Expo React Native) API & Mode Configuration
# Use http://10.0.2.2:8000 on Android Emulator or your LAN IP on physical devices
EXPO_PUBLIC_BOOKIT_API_URL=http://127.0.0.1:8000
EXPO_PUBLIC_BOOKIT_USE_MOCKS=true
# Optional: offline frontend-only demo preview unlock password (backend uses Argon2id database seeds)
EXPO_PUBLIC_BOOKIT_DEMO_SECRET=