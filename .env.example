# BookIt frontend configuration.
# Copy to apps/web/.env.local for the Next.js app.
# Do not put real secrets, card numbers, or production passwords here.

# Future FastAPI origin. Unused while mocks are enabled.
NEXT_PUBLIC_BOOKIT_API_URL=http://localhost:8000

# Keep "true" until the Python API replaces the mock store.
NEXT_PUBLIC_BOOKIT_USE_MOCKS=true

# Demo session signing only. Replace with server-issued httpOnly cookies later.
NEXT_PUBLIC_BOOKIT_DEMO_SECRET=bookit-demo-secret-change-me
