{
  "name": "bookit",
  "private": true,
  "version": "0.1.0",
  "description": "BookIt — multi-vendor booking and marketplace platform (frontend stage).",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @bookit/web dev",
    "dev:web": "pnpm --filter @bookit/web dev",
    "dev:mobile": "pnpm --filter @bookit/mobile start",
    "build": "pnpm --filter @bookit/web build",
    "typecheck": "pnpm -r --if-present typecheck",
    "smoke": "pnpm --filter @bookit/api-client smoke"
  }
}
