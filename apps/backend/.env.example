# Application Environment
ENVIRONMENT=development
APP_NAME=BookIt API
DEBUG=false
LOG_LEVEL=INFO

# Database (PostgreSQL + asyncpg)
DATABASE_URL=postgresql+asyncpg://bookit:change-this-db-password@localhost:5432/bookit
TEST_DATABASE_URL=postgresql+asyncpg://bookit:change-this-db-password@localhost:5432/bookit_test

# Security & JWT (Generate strong random 32+ byte keys for staging/production)
JWT_SECRET_KEY=replace-with-32-byte-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
CSRF_SECRET_KEY=replace-with-32-byte-csrf-secret-key

# Cookies & CORS
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
AUTH_RATE_LIMIT_MAX_ATTEMPTS=12
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Payments & Webhooks (Optional provider integrations)
PAYMENT_PROVIDER=sandbox_unconfigured
PAYMENT_WEBHOOK_SECRET=replace-with-webhook-hmac-secret

# Notifications (Optional provider hooks)
EMAIL_PROVIDER=log_only
PUSH_PROVIDER=log_only
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FCM_SERVER_KEY=
