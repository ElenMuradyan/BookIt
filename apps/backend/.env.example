# Application Environment
ENVIRONMENT=development
APP_NAME=BookIt API
DEBUG=false
LOG_LEVEL=INFO

# Database (PostgreSQL + asyncpg, compatible with local PG & Neon pooled/direct URLs)
DATABASE_URL=postgresql+asyncpg://bookit:change-this-db-password@localhost:5432/bookit
# Optional unpooled direct URL for Alembic migrations (e.g. Neon direct host)
DIRECT_DATABASE_URL=
TEST_DATABASE_URL=postgresql+asyncpg://bookit:change-this-db-password@localhost:5432/bookit_test
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=300
DB_USE_NULL_POOL=false

# Security & JWT (Generate strong random 32+ byte keys for staging/production)
JWT_SECRET_KEY=replace-with-32-byte-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
CSRF_SECRET_KEY=replace-with-32-byte-csrf-secret-key

# Cookies, CORS & Frontend URL (for email verification links)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_BASE_URL=http://localhost:3000

# Rate Limiting & Cooldowns
AUTH_RATE_LIMIT_MAX_ATTEMPTS=12
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# Payments & Webhooks (Optional provider integrations)
PAYMENT_PROVIDER=sandbox_unconfigured
PAYMENT_WEBHOOK_SECRET=replace-with-webhook-hmac-secret

# Notifications (log_only | smtp | resend)
# Outside test mode, setting RESEND_API_KEY or SMTP_HOST automatically selects that provider unless EMAIL_PROVIDER is explicitly set.
EMAIL_PROVIDER=log_only
# Required for live email delivery (e.g. "BookIt <no-reply@yourdomain.com>" using a verified Resend/SMTP domain)
EMAIL_FROM=
PUSH_PROVIDER=log_only
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
RESEND_API_KEY=
RESEND_API_BASE_URL=https://api.resend.com
FCM_SERVER_KEY=
